{
  "name": "dsh-agent-mesh",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A DSH bundle that turns one Router session plus typed Worker sessions into a disciplined mesh: routed dispatch, audited message bus, per-ticket budgets.",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
